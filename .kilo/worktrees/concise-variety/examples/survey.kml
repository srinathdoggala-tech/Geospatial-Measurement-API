<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Example survey</name>
    <Placemark id="plot-1">
      <name>Survey plot</name>
      <ExtendedData><Data name="owner"><value>Ada</value></Data></ExtendedData>
      <Polygon><outerBoundaryIs><LinearRing><coordinates>
        75,18 75.001,18 75.001,18.001 75,18.001 75,18
      </coordinates></LinearRing></outerBoundaryIs></Polygon>
    </Placemark>
    <Placemark id="road-1">
      <name>Access road</name>
      <LineString><coordinates>75,18 75.01,18</coordinates></LineString>
    </Placemark>
    <Placemark id="marker-1">
      <name>Survey marker</name>
      <Point><coordinates>75,18,10</coordinates></Point>
    </Placemark>
  </Document>
</kml>
